{
  "name": "llms-txt-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check:links": "lychee --config ./lychee.toml --verbose .",
    "clean": "git clean -xdf node_modules dist .next",
    "clean:workspaces": "turbo clean",
    "commit": "cz",
    "dev": "pnpm worker:preview",
    "dev:all": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "dev:serpsoftware": "pnpm worker:preview",
    "docs:check": "pnpm tsx scripts/harness/docs-health.ts",
    "docs:garden": "pnpm docs:check && pnpm exec vitest run scripts/architecture-guard.test.ts",
    "harness:fast": "pnpm tsx scripts/harness/runner.ts fast",
    "harness:check": "pnpm tsx scripts/harness/runner.ts full",
    "validate": "pnpm harness:check",
    "agent:dev": "pnpm tsx scripts/harness/agent-runtime.ts dev",
    "agent:doctor": "pnpm tsx scripts/harness/agent-runtime.ts doctor",
    "agent:manifest": "pnpm tsx scripts/harness/agent-runtime.ts manifest",
    "agent:logs": "pnpm tsx scripts/harness/agent-runtime.ts logs",
    "agent:evidence": "pnpm tsx scripts/harness/agent-runtime.ts evidence",
    "agent:ui:capture": "pnpm tsx scripts/harness/ui-capture.ts",
    "worktree:new": "pnpm tsx scripts/harness/worktree.ts new",
    "worktree:init": "pnpm tsx scripts/harness/worktree.ts init",
    "worktree:doctor": "pnpm tsx scripts/harness/worktree.ts doctor",
    "worktree:destroy": "pnpm tsx scripts/harness/worktree.ts destroy",
    "migration:preflight": "pnpm tsx scripts/migration/preflight.ts",
    "d1:local:migrate": "pnpm tsx scripts/d1-local-guard.ts migrate",
    "d1:local:import": "pnpm tsx scripts/d1-local-guard.ts import",
    "d1:local:verify": "pnpm tsx scripts/d1-local-guard.ts verify",
    "d1:local:publish": "pnpm tsx scripts/d1-local-guard.ts publish",
    "d1:publish:production": "pnpm tsx scripts/d1-remote-publisher.ts",
    "d1:approve:production": "pnpm tsx scripts/d1-submission-approver.ts",
    "d1:notify:production": "pnpm tsx scripts/d1-submission-notifier.ts",
    "d1:remote:migration:plan:preview": "pnpm tsx scripts/worker-release.ts plan-migration preview",
    "d1:remote:migration:plan:production": "pnpm tsx scripts/worker-release.ts plan-migration production",
    "d1:remote:verify:plan:preview": "pnpm tsx scripts/worker-release.ts plan-verify preview",
    "d1:remote:verify:plan:production": "pnpm tsx scripts/worker-release.ts plan-verify production",
    "format": "biome check --write .",
    "preview:serpsoftware": "pnpm tsx scripts/d1-local-guard.ts preview",
    "worker:build": "pnpm --filter serp.software build:worker",
    "worker:d1:backup:production": "pnpm tsx scripts/worker-release.ts backup production",
    "worker:d1:import:production": "pnpm tsx scripts/worker-release.ts import production",
    "worker:d1:migrate:production": "pnpm tsx scripts/worker-release.ts migrate production",
    "worker:d1:verify:production": "pnpm tsx scripts/worker-release.ts verify production",
    "worker:config:validate": "pnpm tsx scripts/worker-release.ts validate preview && pnpm tsx scripts/worker-release.ts validate production",
    "worker:preview": "pnpm tsx scripts/d1-local-guard.ts preview",
    "worker:upload:production": "pnpm tsx scripts/worker-release.ts upload production",
    "worker:deploy:production": "pnpm tsx scripts/worker-release.ts deploy production",
    "sync:network-brands": "pnpm tsx scripts/sync-network-brands.ts",
    "audit:sitemaps": "pnpm tsx scripts/audit-sitemaps.ts",
    "generate:badges": "tsx scripts/generate-badges.ts",
    "inventory:badges": "node scripts/inventory-featured-badges.mjs",
    "inventory:r2-badges": "node scripts/inventory-r2-featured-badges.mjs",
    "qc:badges": "pnpm exec vitest run scripts/featured-badge-assets.test.ts scripts/featured-badge-r2-assets.test.ts scripts/logo-assets.test.ts",
    "r2:sync-badges": "node scripts/sync-featured-badges-r2.mjs",
    "postinstall": "manypkg fix",
    "lint": "pnpm lint:forbidden-links && turbo lint && manypkg check",
    "lint:fix": "turbo lint:fix && manypkg fix && pnpm biome lint --write .",
    "lint:forbidden-links": "node scripts/lint-forbidden-links.mjs",
    "audit:forbidden-links": "node scripts/lint-forbidden-links.mjs --generated",
    "shadcn": "cd packages/design-system && pnpm dlx shadcn@canary add",
    "start": "turbo run start",
    "test": "turbo test --cache-dir=.turbo",
    "test:d1": "pnpm exec vitest run scripts/d1-cutover.test.ts scripts/d1-publisher.sqlite.test.ts scripts/d1-remote-publisher.test.ts scripts/d1-submission-approver.test.ts scripts/d1-submission-notifier.test.ts",
    "test:e2e": "turbo test:e2e --filter=e2e",
    "test:e2e:smoke": "turbo test:e2e:smoke --filter=e2e",
    "test:e2e:ui": "turbo test:e2e:ui --filter=e2e",
    "test:e2e:debug": "turbo test:e2e:debug --filter=e2e",
    "test:repo": "pnpm exec vitest run scripts/architecture-guard.test.ts scripts/harness-docs.test.ts scripts/migration-preflight.test.ts scripts/worktree-harness.test.ts scripts/pr-review-workflow.test.ts scripts/labels-workflow.test.ts scripts/ci-workflow-install.test.ts scripts/build-and-deploy-workflow.test.ts scripts/worker-release.test.ts scripts/next-config-build-id.test.ts scripts/network-brands.test.ts scripts/sync-network-brands.test.ts scripts/sitemap-files.test.ts scripts/audit-sitemaps.test.ts scripts/submit-gsc-sitemaps.test.ts scripts/eslint-rules/no-forbidden-listing-links.test.ts scripts/footer-dr-badge.test.ts scripts/featured-badge-assets.test.ts scripts/featured-badge-r2-assets.test.ts packages/web-core/src/category-routes/schema-dates.test.tsx packages/web-core/src/forms/d1-submission-form.test.ts packages/web-core/src/forms/submission-contract.test.ts apps/serp.software/lib/submissions/badge-verifier.test.ts",
    "test:watch": "turbo test:watch --cache-dir=.turbo",
    "typecheck": "turbo typecheck",
    "update": "pnpm update -r",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "contributors:check": "all-contributors check"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^11.3.6",
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.2.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@content-collections/mdx": "^0.2.2",
    "@manypkg/cli": "^0.23.0",
    "@thedaviddias/site-contract": "workspace:*",
    "@thedaviddias/web-core": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "all-contributors-cli": "^6.26.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "lefthook": "^2.1.1",
    "turbo": "^2.8.7",
    "typescript": "catalog:",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "import-in-the-middle": "^1.14.2"
    }
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24"
  }
}
